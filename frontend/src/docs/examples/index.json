  "onec.odata.find_contractor_by_inn": {
    "title": {
      "ru": "OData: найти контрагента по ИНН",
      "en": "OData: find contractor by INN",
      "zh": "OData：按 INN 查找客户"
    },
    "description": {
      "ru": "Учебный пример запроса в Catalog_Контрагенты с $filter, $select и $top=1.",
      "en": "Training example for querying Catalog_Контрагенты with $filter, $select and $top=1.",
      "zh": "使用 $filter、$select 和 $top=1 查询 Catalog_Контрагенты 的训练示例。"
    },
    "endpoint_slug": "odata-explorer",
    "method": "POST",
    "input_mode": "json",
    "headers": {
      "Content-Type": "application/json",
      "X-OMH-Source": "docs"
    },
    "body": {
      "connection": "OData ERP",
      "resource": "Catalog_Контрагенты",
      "filter": "ИНН eq '7707083893' and DeletionMark eq false",
      "select": [
        "Ref_Key",
        "Description",
        "ИНН"
      ],
      "top": 1,
      "save_as": "contractor"
    },
    "expected": {
      "Ref_Key": "contractor-uuid",
      "Description": "ООО Ромашка",
      "ИНН": "7707083893"
    },
    "runnable": true,
    "requires_setup": true
  },
