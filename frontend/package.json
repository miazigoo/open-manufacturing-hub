{
  "name": "open-manufacturing-hub-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "smoke:ui": "node scripts/ui-smoke.mjs",
    "smoke:ui:live": "UI_SMOKE_API_BASE_URL=http://localhost:8000 UI_SMOKE_BASE_URL=http://localhost:5173 node scripts/ui-smoke.mjs",
    "smoke:ui:deep": "node scripts/ui-deep-smoke.mjs",
    "smoke:ui:deep:live": "UI_DEEP_API_BASE_URL=http://localhost:8000 UI_DEEP_BASE_URL=http://localhost:5173 node scripts/ui-deep-smoke.mjs",
    "check:docs": "node scripts/docs-content-check.mjs",
    "docs:screenshots": "node scripts/capture-doc-screenshots.mjs",
    "docs:examples-check": "cd .. && backend/.venv/bin/python backend/scripts/check_docs_examples.py",
    "i18n:missing": "node scripts/i18n-missing-check.mjs",
    "i18n:check": "node scripts/check-hardcoded-text.mjs",
    "docs:quality-check": "node scripts/docs-quality-check.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.83.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "playwright": "^1.61.1"
  }
}
