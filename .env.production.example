# Open Manufacturing Hub production profile example.
# Copy to .env.production and replace every change-me value before first start.

APP_ENV=production
OMH_APP_ENV=production
OMH_APP_VERSION=0.1.0
OMH_PRODUCTION_PROFILE=true

# Public URL shown in diagnostics and used by docs/UI links.
PUBLIC_BASE_URL=https://omh.factory.local
PUBLIC_API_BASE_URL=https://omh.factory.local
VITE_PUBLIC_BASE_URL=https://omh.factory.local
HTTP_PORT=80

# PostgreSQL container and async SQLAlchemy URL used by backend/worker.
POSTGRES_DB=omh
POSTGRES_USER=omh
POSTGRES_PASSWORD=change-me-long-random-db-password
DATABASE_URL=postgresql+asyncpg://omh:change-me-long-random-db-password@postgres:5432/omh
OMH_DATABASE_URL=postgresql+asyncpg://omh:change-me-long-random-db-password@postgres:5432/omh

# Required in production. Use at least 32 random characters.
OMH_SECRET_KEY=change-me-32-plus-random-characters
SECRET_KEY=change-me-32-plus-random-characters

# UI talks to backend through nginx. Keep this relative behind the reverse proxy.
VITE_API_BASE_URL=/api

# Browser origins allowed to call API directly. Prefer the public HTTPS URL in production.
CORS_ORIGINS=https://omh.factory.local
# Disable regex-based origins in production unless you intentionally need them.
CORS_ALLOW_ORIGIN_REGEX=^$

# Runtime safety defaults.
OMH_AUTO_INSTALL_PACKAGES=
ALLOW_DEMO_SEED_IN_PRODUCTION=false
OMH_ALLOW_DEMO_SEED_IN_PRODUCTION=false
SYNC_PROCESSING_TIMEOUT_SECONDS=30
QUEUE_LOCK_SECONDS=300
QUEUE_WORKER_BATCH_SIZE=10
QUEUE_WORKER_LOOP_INTERVAL_SECONDS=5
OMH_REQUIRE_WORKER_HEARTBEAT=false
AUDIT_RETENTION_DAYS=180
XML_MAX_BYTES=10485760
XML_FULL_ARTIFACT_MAX_BYTES=1048576

# Directory where OMH writes marking-code pool TXT files received from 1C.
# For a laser PC share, mount the SMB directory on the host and point this
# variable to the mounted path inside the backend container.
OMH_MARKING_CODE_POOL_EXPORT_DIR=/app/exports/marking-code-pools
